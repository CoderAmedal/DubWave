{
  "manifest_version": 3,
  "name": "DubWave（视频字幕配音）",
  "version": "0.3.0",
  "description": "YouTube / Bilibili 字幕翻译 + 本地 Edge TTS 实时配音。独立实现的 clean-room 版本。",
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "permissions": [
    "storage",
    "tts"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://translate.googleapis.com/*",
    "http://127.0.0.1:8758/*",
    "http://localhost:8758/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DubWave",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/engine.js",
        "src/adapters/youtube.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": [
        "src/engine.js",
        "src/adapters/bilibili.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
